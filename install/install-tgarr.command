#!/bin/bash
# tgarr for macOS - double-click to install (it opens in Terminal).
# What it does, step by step: https://github.com/tgarrpro/tgarr/blob/main/docs/install/desktop.md
curl -fsSL https://raw.githubusercontent.com/tgarrpro/tgarr/main/install/install.sh | bash
echo
read -r -p "Press Return to close this window " _
