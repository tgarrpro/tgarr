# tgarr settings. Copy to .env (next to docker-compose.yml) and fill in.
# Keep it private:  chmod 600 .env

# ── required ─────────────────────────────────────────────────────────
# Telegram API credentials: https://my.telegram.org/apps  ("API development tools")
TG_API_ID=
TG_API_HASH=

# Two secrets of your own making. For example:
#   openssl rand -hex 24      and      openssl rand -hex 32
DB_PASSWORD=
MEILI_MASTER_KEY=

# ── optional ─────────────────────────────────────────────────────────
# Port of the web interface (default 8765).
#TGARR_PORT=8765

# Where grabbed and opened files are kept (default ./_data/downloads).
# Point it at the folder Sonarr / Radarr import from.
#TGARR_DOWNLOADS=/path/to/downloads

# Stay on one version instead of following new releases, e.g. 0.5.6.
#TGARR_TAG=latest

# Only if the updater (tgarr-watchtower) keeps restarting with "client version
# ... is too new/old": the Docker API version it should speak. `docker version`
# shows what your engine accepts.
#TGARR_DOCKER_API=1.40

# Posters and titles from themoviedb.org (free key). Without it tgarr still
# recognises titles through Wikidata, with fewer posters. Can also be set
# later on the Settings page.
#TMDB_API_KEY=

# Ask for a password before showing the web interface, and/or a key for the
# Sonarr / Radarr endpoints. Recommended if the port is reachable by others.
#TGARR_UI_PASSWORD=
#TGARR_API_KEY=

# The address other machines use to reach tgarr, if it is not the one in the
# browser's address bar (reverse proxy): http://tgarr.example.lan
#TGARR_BASE_URL=
